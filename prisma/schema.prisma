// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

generator erd {
  provider                  = "prisma-erd-generator"
  output                    = "../../docs/DER.svg"
  theme                     = "default"
  includeRelationFromFields = true
  disabled                  = env("DISABLE_ERD")
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {

  id    String @id @unique @default(uuid())
  name  String
  email String @unique
  cpf   String @unique

  bankingAccounts BankAccount[]
  extract         Extract[]

  expenses        Expense[]
  expenseCategory ExpenseCategory[]

  createdAt DateTime @default(now())

  @@map("users")
}

model BankAccount {

  id            String @id @unique @default(uuid())
  accountNumber String @unique
  agency        Int    @unique
  bank          Bank
  balance       Float

  extract Extract[]

  user   User   @relation(fields: [userId], references: [id])
  userId String

  createdAt DateTime @default(now())

  @@map("bankingAccounts")
}

model Extract {

  id          String      @id @unique @default(uuid())
  description String
  value       Float
  date        DateTime
  type        ExtractType

  expense   Expense @relation(fields: [expenseId], references: [id])
  expenseId String

  bank   BankAccount @relation(fields: [bankId], references: [id])
  bankId String

  user   User   @relation(fields: [userId], references: [id])
  userId String

  createdAt DateTime @default(now())

  @@map("extracts")
}

model Expense {

  id    String      @id @unique @default(uuid())
  name  String
  value Float? // Value is optional when type is fixed 
  type  ExpenseType

  extract Extract[]

  user   User   @relation(fields: [userId], references: [id])
  userId String

  category   ExpenseCategory @relation(fields: [categoryId], references: [id])
  categoryId String

  createdAt DateTime @default(now())

  @@map("expenses")
}

model ExpenseCategory {

  id   String @id @unique @default(uuid())
  name String

  expenses Expense[]

  user   User   @relation(fields: [userId], references: [id])
  userId String

  createdAt DateTime @default(now())

  @@map("expensesCategories")
}

enum ExpenseType {
  Fixed
  Variable
}

enum ExtractType {
  Entry
  Exit
}

enum Bank {
  Nubank
  Itau
  PicPay
  Pan
  Caixa
  Bradesco
}
